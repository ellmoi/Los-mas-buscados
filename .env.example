# Copiar a .env y ejecutar: node --env-file=.env server.mjs
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
DATA_DIR=./data
# file guarda correos de prueba en DATA_DIR/mail; no los envía.
MAIL_MODE=file
# Producción: MAIL_MODE=resend, remitente verificado y clave privada.
# RESEND_API_KEY=
# MAIL_FROM=Buscados <cuentas@tu-dominio.com>
